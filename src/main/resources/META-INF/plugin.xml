<idea-plugin>
    <id>org.taigaui.designtokens</id>
    <name>Taiga UI Companion</name>
    <vendor url="https://github.com/splincode">splincode</vendor>

    <description><![CDATA[
        <p>
            <strong>Taiga UI Companion</strong> is a community-maintained WebStorm plugin for developers working with Taiga UI.
            It brings project-aware design tokens, icons, CSS units, and event-plugin tooling directly into the editor.
        </p>

        <p>
            Instead of shipping a fixed catalog, the plugin reads the Taiga UI packages installed in the current project
            and combines them with reachable project styles. Completion and previews therefore match the version and overrides
            that the project actually uses.
        </p>

        <h3>Features</h3>
        <ul>
            <li>
                <strong>Design token completion</strong> for CSS, Less, and SCSS <code>var(--tui-...)</code> references,
                with resolved values, color previews, reference chains, and source navigation.
            </li>
            <li>
                <strong>Project-aware overrides</strong> so local token declarations are shown alongside installed-package values
                and the effective value is easy to understand.
            </li>
            <li>
                <strong>Token inspections and quick fixes</strong> for unknown and explicitly deprecated Taiga UI tokens.
            </li>
            <li>
                <strong><code>@tui.*</code> icon completion and preview</strong> in JavaScript, TypeScript, HTML, and Angular templates,
                using the icon packages available in the current project.
            </li>
            <li>
                <strong><code>rem</code> to <code>px</code> inlay hints</strong> for CSS, Less, SCSS, Angular component styles,
                and numeric Angular <code>.rem</code> style bindings.
            </li>
            <li>
                <strong>Taiga UI event-plugin support</strong> in Angular templates and TypeScript host metadata,
                including completion, validation, duplicate/unknown modifier inspections, and hover documentation.
            </li>
        </ul>

        <h3>Getting started</h3>
        <p>
            Install the plugin, open a project that uses Taiga UI, and let WebStorm finish indexing.
            No separate token catalog or manual synchronization is required.
        </p>
        <ul>
            <li>Type <code>var(--tui-</code> in CSS, Less, or SCSS to explore available design tokens.</li>
            <li>Hover a complete token reference to inspect resolved values and where they come from.</li>
            <li>Type <code>@tui.</code> in supported JavaScript, TypeScript, HTML, or Angular contexts to browse icons.</li>
            <li>Open <strong>Settings → Tools → Taiga UI</strong> to configure editor presentation features.</li>
        </ul>

        <h3>About the project</h3>
        <p>
            The plugin is developed in the open by <strong>splincode-taiga-labs</strong> as an independent community project
            focused on improving the developer experience around Taiga UI in JetBrains IDEs.
        </p>
        <p>
            This project is not an official Taiga UI or T-Bank product.
            Source code, issue tracking, and contributions are available on
            <a href="https://github.com/splincode-taiga-labs/taiga-ui-jetbrains-plugin">GitHub</a>.
        </p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>JavaScript</depends>
    <depends>AngularJS</depends>
    <depends>com.intellij.css</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            id="org.taigaui.designtokens.settings"
            parentId="tools"
            displayName="Taiga UI"
            instance="org.taigaui.designtokens.settings.TaigaDesignTokensConfigurable"
        />
        <polySymbols.webTypes
            source="web-types/event-plugins@3.1.0.web-types.json"
            enableByDefault="false"
        />
        <platform.backend.documentation.targetProvider
            implementation="org.taigaui.designtokens.documentation.TaigaQuickDocumentationTargetProvider"
        />
        <platform.backend.documentation.lookupElementTargetProvider
            implementation="org.taigaui.designtokens.documentation.TaigaQuickDocumentationTargetProvider"
        />
        <psi.referenceContributor
            language="CSS"
            implementation="org.taigaui.designtokens.navigation.DesignTokenReferenceContributor"
        />
        <psi.referenceContributor
            language="LESS"
            implementation="org.taigaui.designtokens.navigation.DesignTokenReferenceContributor"
        />
        <psi.referenceContributor
            language="SCSS"
            implementation="org.taigaui.designtokens.navigation.DesignTokenReferenceContributor"
        />
        <completion.contributor
            language="CSS"
            order="first"
            implementationClass="org.taigaui.designtokens.completion.DesignTokenCompletionContributor"
        />
        <completion.contributor
            language="LESS"
            order="first"
            implementationClass="org.taigaui.designtokens.completion.DesignTokenCompletionContributor"
        />
        <completion.contributor
            language="SCSS"
            order="first"
            implementationClass="org.taigaui.designtokens.completion.DesignTokenCompletionContributor"
        />
        <completion.contributor
            id="TaigaUIEventPluginHostCompletionContributor"
            language="TypeScript"
            order="first, before JSPatternBasedCompletionContributor, before JSCompletionContributor"
            implementationClass="org.taigaui.designtokens.events.TypeScriptHostEventPluginCompletionContributor"
        />
        <completion.contributor
            language="any"
            implementationClass="org.taigaui.designtokens.icons.IconCompletionContributor"
        />
        <localInspection
            shortName="UnknownTaigaUIDesignToken"
            displayName="Unknown Taiga UI design token"
            groupName="Taiga UI"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="org.taigaui.designtokens.completion.UnknownDesignTokenInspection"
        />
        <localInspection
            shortName="DeprecatedTaigaUIDesignToken"
            displayName="Deprecated Taiga UI design token"
            groupName="Taiga UI"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="org.taigaui.designtokens.completion.DeprecatedDesignTokenInspection"
        />
        <localInspection
            shortName="UnknownTaigaUIEventModifier"
            displayName="Unknown Taiga UI event modifier"
            groupName="Taiga UI"
            enabledByDefault="true"
            language="HtmlCompatible"
            level="ERROR"
            implementationClass="org.taigaui.designtokens.events.UnknownEventPluginModifierInspection"
        />
        <localInspection
            shortName="DuplicateTaigaUIEventModifier"
            displayName="Duplicate Taiga UI event modifier"
            groupName="Taiga UI"
            enabledByDefault="true"
            language="HtmlCompatible"
            level="ERROR"
            implementationClass="org.taigaui.designtokens.events.DuplicateEventPluginModifierInspection"
        />
        <localInspection
            shortName="InvalidTaigaUIEventModifierInHostBinding"
            displayName="Invalid Taiga UI event modifier in Angular host binding"
            groupName="Taiga UI"
            enabledByDefault="true"
            language="TypeScript"
            level="ERROR"
            implementationClass="org.taigaui.designtokens.events.TypeScriptEventPluginModifierInspection"
        />
        <lang.inspectionSuppressor
            language="TypeScript"
            implementationClass="org.taigaui.designtokens.events.TypeScriptHostEventPluginInspectionSuppressor"
        />
        <daemon.highlightInfoFilter
            implementation="org.taigaui.designtokens.events.EventPluginKeyEventHighlightInfoFilter"
        />
        <typedHandler
            implementation="org.taigaui.designtokens.icons.IconCompletionAutoPopupHandler"
            order="first, before completionAutoPopup"
        />
        <typedHandler
            implementation="org.taigaui.designtokens.completion.DesignTokenCompletionAutoPopupHandler"
        />
        <typedHandler
            implementation="org.taigaui.designtokens.events.TypeScriptHostEventPluginCompletionAutoPopupHandler"
            order="first, before completionAutoPopup"
        />
        <codeInsight.declarativeInlayProvider
            group="VALUES_GROUP"
            bundle="messages.TaigaDesignTokensBundle"
            implementationClass="org.taigaui.designtokens.units.RemInlayHintsProvider"
            isEnabledByDefault="true"
            language="CSS"
            nameKey="inlay.rem.px.name"
            descriptionKey="inlay.rem.px.description"
            providerId="taiga.rem.px.styles"
        />
        <codeInsight.declarativeInlayProvider
            group="VALUES_GROUP"
            bundle="messages.TaigaDesignTokensBundle"
            implementationClass="org.taigaui.designtokens.units.RemInlayHintsProvider"
            isEnabledByDefault="true"
            language="HTML"
            nameKey="inlay.rem.px.name"
            descriptionKey="inlay.rem.px.description"
            providerId="taiga.rem.px.templates"
        />
        <codeInsight.declarativeInlayProvider
            group="VALUES_GROUP"
            bundle="messages.TaigaDesignTokensBundle"
            implementationClass="org.taigaui.designtokens.units.RemInlayHintsProvider"
            isEnabledByDefault="true"
            language="JavaScript"
            nameKey="inlay.rem.px.name"
            descriptionKey="inlay.rem.px.description"
            providerId="taiga.rem.px.embedded.styles"
        />
        <editorFactoryMouseListener
            implementation="org.taigaui.designtokens.events.EventPluginsHoverPopupListener"
        />
        <editorFactoryMouseMotionListener
            implementation="org.taigaui.designtokens.events.EventPluginsHoverPopupListener"
        />
        <editorFactoryMouseListener
            implementation="org.taigaui.designtokens.documentation.DesignTokenHoverPopupListener"
        />
        <editorFactoryMouseMotionListener
            implementation="org.taigaui.designtokens.documentation.DesignTokenHoverPopupListener"
        />
        <editorFactoryMouseListener
            implementation="org.taigaui.designtokens.icons.IconHoverPopupListener"
        />
        <editorFactoryMouseMotionListener
            implementation="org.taigaui.designtokens.icons.IconHoverPopupListener"
        />
    </extensions>
</idea-plugin>
